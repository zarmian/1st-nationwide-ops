# 1st Nationwide Ops — environment variables
# Copy this file to .env.local for local dev, or set these in Vercel project settings.

# ── Database (Supabase Postgres, EU-West London region) ──────────────────────
# Pooled connection (used by app at runtime).
# - pgbouncer=true tells Prisma to play nicely with Supabase's transaction pooler.
# - connection_limit=5 lets a single Vercel function run a few parallel queries
#   without queueing. With 1, pages that fire several count() in parallel
#   (admin home, reset-counts) time out under load.
# - pool_timeout=20 gives queued queries 20s to acquire a connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# Direct connection (used by Prisma migrate). Port 5432, no pgbouncer.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# In production this is your Vercel URL. Locally use http://localhost:3000.
NEXTAUTH_URL="http://localhost:3000"

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL used in emails / report PDFs. No trailing slash.
APP_URL="http://localhost:3000"
# Default region for new sites (LONDON or OUTSIDE_LONDON)
DEFAULT_REGION="LONDON"

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Vercel sends Authorization: Bearer <CRON_SECRET> with each cron request.
# In production this MUST be set; locally it can be omitted (auth is bypassed
# in non-production).
CRON_SECRET=""

# ── Rate limiting (Vercel KV / Upstash Redis) ───────────────────────────────
# Create a Vercel KV store (Vercel dashboard → Storage → Create → KV) and it
# auto-populates these env vars in the project. Without them, rate limiting
# is a no-op (allowed) — fine for local dev, lax for production.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ── Sentry (error tracking) ─────────────────────────────────────────────────
# Free tier covers a single-tenant ops tool comfortably. Without these set,
# Sentry stays no-op (no events sent, build skips sourcemap upload).
SENTRY_DSN=""
# Public DSN for client-side errors. Same DSN, exposed to the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=""
# Required for sourcemap upload at build time (CI only).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── At-rest encryption ──────────────────────────────────────────────────────
# AES-256-GCM key for sensitive fields (alarm codes, padlock codes).
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DO NOT rotate without re-encrypting existing rows — old ciphertext won't
# decrypt under a new key.
ENCRYPTION_KEY=""

# ── WhatsApp Business (Meta Cloud API) ──────────────────────────────────────
# Until both are set, the app queues notifications but skips actual sending.
# Step-by-step Meta setup: docs/whatsapp-setup.md
# - Phone Number ID from Meta Business → WhatsApp → API Setup
WHATSAPP_PHONE_ID=""
# - Permanent System User token with `whatsapp_business_messaging` scope
WHATSAPP_ACCESS_TOKEN=""
