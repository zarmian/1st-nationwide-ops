// =============================================================
//  1st Nationwide Ops — Prisma schema (v1.2)
//  Postgres / Supabase EU-West
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, citext]
}

// ----------- Enums -----------

enum UserRole {
  ADMIN
  DISPATCHER
  OFFICER
  /// Partner-organisation seat. role=PARTNER + partnerId set means
  /// the user logs into the partner portal (/partner/*), with every
  /// query scoped to that single partner. They never see our own
  /// staff or other partners' data.
  PARTNER
  /// Individual officer working for a partner. Logs into the
  /// /partner/m/* mobile surface. Each PARTNER_OFFICER User is
  /// linked 1:1 to a PartnerOfficer roster row via that row's
  /// userId. Hard-locked to /partner/m/* by middleware.
  PARTNER_OFFICER
}

enum SiteType {
  COMMERCIAL
  RESIDENTIAL
  RETAIL
  STORAGE
  INDUSTRIAL
  OTHER
}

enum ServiceTag {
  ALARM_RESPONSE
  KEYHOLDING
  LOCKUP
  UNLOCK
  VPI
  PATROL
  STATIC_GUARDING
  DOG_HANDLER
  ADHOC
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum CustomerType {
  CORPORATE
  RESIDENTIAL
  RESELLER
}

enum KeyType {
  KEY
  FOB
  PADLOCK
  CODE
}

enum KeyStatus {
  WITH_US
  WITH_OFFICER
  WITH_CUSTOMER
  LOST
  RETIRED
}

enum PatrolFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ScheduleKind {
  PATROL
  VPI
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum VisitStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  LATE
  MISSED
  CANCELLED
}

/// Rota half-day. DAY = 06:00-18:00 UK, NIGHT = 18:00-06:00 UK (next
/// calendar day). The "date" anchor on rota rows is the calendar date
/// the shift STARTS on, so a NIGHT entry for 2026-06-13 covers
/// 18:00 on Sat 13 Jun through 06:00 on Sun 14 Jun.
enum RotaShift {
  DAY
  NIGHT
}

enum OnboardingStage {
  PROPOSED
  SURVEY
  KEY_COLLECTION
  GO_LIVE
  CANCELLED
}

enum CustomerProgram {
  TESCO
  SHURGARD
  OTHER
}

enum AlarmSource {
  ARC_EMAIL
  ARC_PHONE
  PARTNER_EMAIL
  PARTNER_PHONE
  CUSTOMER_PHONE
  MANUAL
  WEBHOOK
}

enum PartnerRole {
  CUSTOMER
  SUBCONTRACTOR
  BOTH
}

enum PartnerChannel {
  EMAIL
  PHONE
  THEIR_APP
  WHATSAPP
  PORTAL
}

enum JobType {
  ALARM_RESPONSE
  PATROL
  LOCK
  UNLOCK
  KEY_COLLECTION
  KEY_DROPOFF
  SURVEY
  VPI
  ADHOC
  STATIC_GUARDING_SHIFT
  DOG_HANDLER_SHIFT
}

enum JobSource {
  SCHEDULED
  ALARM
  PARTNER_REQUEST
  CUSTOMER_REQUEST
  ONBOARDING
  AD_HOC
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVIEW_PENDING
  APPROVED
  SENT_TO_CLIENT
  CLOSED
  CANCELLED
}

enum ResponderType {
  INTERNAL_OFFICER
  PARTNER
  EXTERNAL_NAMED
}

enum SubmissionForm {
  ALARM_RESPONSE
  PATROL
  LOCK
  UNLOCK
  KEY_COLLECTION
  KEY_DROPOFF
  VPI
  ADHOC
  SHIFT_CHECK
}

enum ShiftType {
  STATIC_GUARDING
  DOG_HANDLER
}

enum ShiftStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
  ABANDONED
}

enum TemplateScope {
  GLOBAL
  CUSTOMER
  PARTNER
  SITE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED_AND_APPROVED
}

enum ReportChannel {
  EMAIL
  PORTAL_DOWNLOAD
  WHATSAPP
}

enum ReportStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum AlarmPriority {
  LOW
  MEDIUM
  HIGH
}

enum AlarmOutcome {
  FALSE_ALARM
  GENUINE
  RESOLVED
  ESCALATED_TO_POLICE
  OTHER
}

enum RateService {
  ALARM_RESPONSE
  KEYHOLDING
  LOCKUP
  UNLOCK
  VPI
  PATROL
  STATIC_GUARDING
  DOG_HANDLER
  ADHOC
  ANNUAL_SUBSCRIPTION
  SITE_SETUP
}

enum RateUnit {
  PER_VISIT
  PER_HOUR
  PER_MONTH
  PER_YEAR
  FIXED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationKind {
  VISIT_STARTED
  VISIT_COMPLETED
  VISIT_LATE
  VISIT_MISSED
  ALARM_RECEIVED
  KEY_HANDOVER
  SHIFT_CHECK_OVERDUE
  SHIFT_REMINDER
  JOB_REMINDER
  OFFICER_NO_SHOW
  ALARM_CUSTOMER_ACK
  PAY_SUMMARY
  SHIFT_LINK
  MISSED_CALL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ----------- Models -----------

model Region {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  leadUserId  String?  @db.Uuid
  leadUser    User?    @relation("RegionLead", fields: [leadUserId], references: [id])
  notes       String?

  sites           Site[]
  officers        User[]            @relation("OfficerRegion")
  rotaAssignments RotaAssignment[]
}

/// Officer-set availability for a given UK calendar date + half-day
/// shift. One row per (officer, date, shift). Existence = available;
/// absence = not available. Toggled from /m/rota.
model OfficerAvailability {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officerId String    @db.Uuid
  officer   User      @relation(fields: [officerId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  shift     RotaShift
  notes     String?
  createdAt DateTime  @default(now())

  @@unique([officerId, date, shift])
  @@index([date, shift])
}

/// Dispatcher-set rota assignment — officer X is on for region R on
/// date D, shift S. Multiple officers can be assigned per region+shift
/// (the unique key includes officer). Officers see their own
/// assignments on /m/rota; dispatch manages all of them on /rota.
model RotaAssignment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date            DateTime  @db.Date
  shift           RotaShift
  regionId        Int
  region          Region    @relation(fields: [regionId], references: [id])
  officerId       String    @db.Uuid
  officer         User      @relation("RotaAssignmentOfficer", fields: [officerId], references: [id], onDelete: Cascade)
  notes           String?
  createdByUserId String?   @db.Uuid
  createdBy       User?     @relation("RotaAssignmentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())

  @@unique([date, shift, regionId, officerId])
  @@index([officerId, date])
  @@index([regionId, date, shift])
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String   @unique @db.Citext
  name            String
  passwordHash    String?
  phone           String?
  whatsappNumber  String?
  siaNumber       String?  @unique
  role            UserRole
  regionId      Int?
  region        Region?  @relation("OfficerRegion", fields: [regionId], references: [id])
  active        Boolean  @default(true)
  onDuty        Boolean  @default(false)
  lastLat       Float?
  lastLng       Float?
  lastSeenAt    DateTime?
  /// ── Telegram bot link ────────────────────────────────────────────────
  /// The user's Telegram chat id once they've connected the bot. Used to DM
  /// them alerts/duty and to authorise inbound commands.
  telegramChatId       String?  @unique
  /// One-time code the user generates in-app and sends to the bot (via a
  /// t.me deep link) to link their account. Cleared once linked.
  telegramLinkCode     String?  @unique
  telegramLinkExpires  DateTime?
  /// Job the officer is being asked to share a Telegram location for, set
  /// when they tap On-site/Complete and cleared once they share (or skip).
  pendingLocationJobId String?  @db.Uuid
  /// Partner-portal scope. Only set when role = PARTNER (and future
  /// PARTNER_OFFICER). The portal hard-locks every query to this id.
  partnerId     String?  @db.Uuid
  partner       Partner? @relation("PartnerUsers", fields: [partnerId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  defaultResponderForSites Site[]              @relation("DefaultResponder")
  patrolSchedules          PatrolSchedule[]
  patrolVisits             PatrolVisit[]
  lockUnlockSchedules      LockUnlockSchedule[]
  alarmEventsAssigned      AlarmEvent[]        @relation("AlarmAssignedTo")
  keysHeld                 Key[]               @relation("KeyHolder")
  keyMovementsFrom         KeyMovement[]       @relation("KeyMoveFrom")
  keyMovementsTo           KeyMovement[]       @relation("KeyMoveTo")
  keyMovementsSignedOff    KeyMovement[]       @relation("KeyMoveSignedOff")
  activityLogs             ActivityLog[]
  regionsLed               Region[]            @relation("RegionLead")
  jobsAsResponder          Job[]               @relation("JobResponderUser")
  jobsCancelled            Job[]               @relation("JobCancelledBy")
  jobsRecorded             Job[]               @relation("JobRecordedBy")
  formSubmissions          FormSubmission[]    @relation("SubmittedByUser")
  reportReviews            ReportReview[]      @relation("ReportReviewer")
  formTemplatesAuthored    FormTemplate[]      @relation("FormTemplateAuthor")
  formBlueprintsAuthored   FormBlueprint[]     @relation("FormBlueprintAuthor")
  notifications            Notification[]      @relation("NotificationRecipient")
  officerRates             OfficerRate[]
  payAdjustments           PayAdjustment[]
  shifts                   Shift[]             @relation("ShiftOfficer")
  rotaAvailability         OfficerAvailability[]
  rotaAssignments          RotaAssignment[]    @relation("RotaAssignmentOfficer")
  rotaAssignmentsCreated   RotaAssignment[]    @relation("RotaAssignmentCreatedBy")
  /// 1:1 back-relation — set when role=PARTNER_OFFICER, points to the
  /// roster row this login backs.
  partnerOfficerSeat       PartnerOfficer?     @relation("PartnerOfficerLogin")
  telegramCalloutDrafts    TelegramCalloutDraft[] @relation("TelegramDraftCreatedBy")

  @@index([regionId, role])
  @@index([partnerId])
}

model Customer {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String        @unique
  type            CustomerType  @default(CORPORATE)
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  billingAddress  String?
  contractRef     String?
  contractStart   DateTime?
  contractEnd     DateTime?
  notes           String?
  /// Opt-in for alarm-response SMS acknowledgements to contactPhone.
  /// Default false so we never text a customer who hasn't agreed.
  smsAlertsOn     Boolean       @default(false)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sites           Site[]
  jobs            Job[]
  contacts        CustomerContact[]
  formTemplates   FormTemplate[]
  rates           CustomerRate[]
  invoices        Invoice[]
  recurringCharges RecurringCharge[]
  creditNotes     CreditNote[]

  @@index([name])
}

model CustomerContact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @db.Uuid
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  email       String?
  phone       String?
  ref         String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model Site {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String?      @unique
  name                  String
  addressLine           String
  postcode              String
  postcodeFormatted     String
  city                  String?
  lat                   Float?
  lng                   Float?
  /// Geofence radius in metres for shift start/check-in/end location
  /// matching. Null → fall back to the app default (300 m). Per-site
  /// override for awkward locations (large estates, poor GPS).
  geofenceRadiusM       Int?
  type                  SiteType     @default(COMMERCIAL)
  regionId              Int?
  region                Region?      @relation(fields: [regionId], references: [id])
  customerId            String?      @db.Uuid
  customer              Customer?    @relation(fields: [customerId], references: [id])
  partnerId             String?      @db.Uuid
  partner               Partner?     @relation("PartnerSites", fields: [partnerId], references: [id])
  defaultResponderId    String?      @db.Uuid
  defaultResponder      User?        @relation("DefaultResponder", fields: [defaultResponderId], references: [id])
  services              ServiceTag[] @default([])
  riskLevel             RiskLevel    @default(LOW)
  notes                 String?
  active                Boolean      @default(true)
  // ── partner-supplied site metadata (Nexus, etc.) ─────────────────────────
  partnerReference      String?
  partnerSin            String?
  sapRef                String?
  opsUnit               String?
  what3words            String?
  partnerStatus         String?
  startDate             DateTime?
  terminationDate       DateTime?
  dne                   Boolean      @default(false)
  hsMarkers             Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  keys                  Key[]
  keySets               KeySet[]
  accessInstruction     AccessInstruction?
  patrolSchedules       PatrolSchedule[]
  patrolVisits          PatrolVisit[]
  lockUnlockSchedules   LockUnlockSchedule[]
  alarmEvents           AlarmEvent[]
  onboardingPipelines   OnboardingPipeline[]
  jobs                  Job[]
  formSubmissions       FormSubmission[]
  formTemplates         FormTemplate[]
  rates                 SiteRate[]
  shifts                Shift[]

  @@index([regionId])
  @@index([customerId])
  @@index([partnerId])
  @@index([postcode])
  @@index([type])
  @@index([active])
  @@index([partnerReference])
}

model SiteRate {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String       @db.Uuid
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  service         RateService
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @default("GBP")
  unit            RateUnit     @default(PER_VISIT)
  // Minutes covered by `amount`. Beyond this, excessRatePerMin applies.
  includedMinutes Int?
  excessRatePerMin Decimal?    @db.Decimal(10, 4)
  validFrom       DateTime?
  validTo         DateTime?
  notes           String?
  source          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([siteId, service])
  @@index([siteId])
  @@index([service])
}

/// Customer-level default rate card. Applies to every site under the
/// customer unless that site has its own SiteRate for the same service
/// (site overrides win — see billForSite / mergeRates). Same shape as
/// SiteRate so the calculator treats them identically once merged.
model CustomerRate {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String       @db.Uuid
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service         RateService
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @default("GBP")
  unit            RateUnit     @default(PER_VISIT)
  includedMinutes Int?
  excessRatePerMin Decimal?    @db.Decimal(10, 4)
  validFrom       DateTime?
  validTo         DateTime?
  notes           String?
  source          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([customerId, service])
  @@index([customerId])
  @@index([service])
}

model KeySet {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId      String   @db.Uuid
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  internalNo  String?  @unique
  label       String
  notes       String?
  // Reference photo of the physical set — operator-uploaded so officers
  // can recognise the actual bunch on arrival. Stored as a Vercel Blob URL.
  photoUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  keys        Key[]

  @@index([siteId])
}

model Key {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internalNo          String?       @unique
  label               String
  type                KeyType
  siteId              String?       @db.Uuid
  site                Site?         @relation(fields: [siteId], references: [id])
  keySetId            String?       @db.Uuid
  keySet              KeySet?       @relation(fields: [keySetId], references: [id], onDelete: SetNull)
  copyOfId            String?       @db.Uuid
  copyOf              Key?          @relation("KeyCopies", fields: [copyOfId], references: [id], onDelete: SetNull)
  copies              Key[]         @relation("KeyCopies")
  duplicable          Boolean       @default(true)
  currentHolderUserId String?       @db.Uuid
  currentHolder       User?         @relation("KeyHolder", fields: [currentHolderUserId], references: [id])
  status              KeyStatus     @default(WITH_US)
  qrId                String?       @unique
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  movements           KeyMovement[]

  @@index([siteId])
  @@index([keySetId])
  @@index([copyOfId])
  @@index([currentHolderUserId])
  @@index([status])
}

model KeyMovement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyId           String   @db.Uuid
  key             Key      @relation(fields: [keyId], references: [id], onDelete: Cascade)
  fromUserId      String?  @db.Uuid
  fromUser        User?    @relation("KeyMoveFrom", fields: [fromUserId], references: [id])
  toUserId        String?  @db.Uuid
  toUser          User?    @relation("KeyMoveTo", fields: [toUserId], references: [id])
  occurredAt      DateTime @default(now())
  reason          String?
  notes           String?
  signedOffById   String?  @db.Uuid
  signedOffBy     User?    @relation("KeyMoveSignedOff", fields: [signedOffById], references: [id])

  @@index([keyId, occurredAt])
}

model AccessInstruction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String   @unique @db.Uuid
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  alarmCodeEnc    Bytes?
  padlockCodeEnc  Bytes?
  alarmCode       String?
  padlockCode     String?
  entryStepsMd    String?
  lockboxId       String?
  hazards         String?
  updatedAt       DateTime @updatedAt
  updatedBy       String?  @db.Uuid
}

model PatrolSchedule {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId            String          @db.Uuid
  site              Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind              ScheduleKind    @default(PATROL)
  dayOfWeek         DayOfWeek
  frequency         PatrolFrequency @default(WEEKLY)
  // "HH:MM" UK wall-clock. When null, falls back to the kind default
  // (09:00 for VPI, 22:00 for patrols). Time interpretation is via
  // ukWallClockToUtc so a value like "08:00" lands at 08:00 BST in
  // summer / 08:00 GMT in winter, never an hour adrift on the server.
  // Legacy single time — kept in sync with timesOfDay[0] for old readers.
  timeOfDay         String?
  // Multiple patrol times for each matching day ("HH:MM" UK wall-clock, in
  // run order). One PatrolVisit is materialised per time. A time earlier
  // than the previous one is treated as crossing midnight: it lands on the
  // next calendar day but stays grouped under the night it started. Empty
  // → fall back to timeOfDay, then the kind default.
  timesOfDay        String[]        @default([])
  // Custom recurrence: when set, overrides the frequency enum and means
  // "every N weeks starting from the anchor." 1=weekly, 2=fortnightly,
  // 3=every 3rd week, etc. Null = use frequency enum.
  intervalWeeks     Int?
  // Per-schedule date skips ("YYYY-MM-DD"). If forDate's UK ISO date
  // matches, the cron skips materialising for that day — useful for
  // holidays, one-off pauses.
  exceptionDates    String[]        @default([])
  assignedOfficerId String?         @db.Uuid
  assignedOfficer   User?           @relation(fields: [assignedOfficerId], references: [id])
  /// Subcontracted patrols: assign the schedule to a partner instead of an
  /// internal officer (mutually exclusive with assignedOfficerId in the UI).
  handledByPartnerId String?        @db.Uuid
  handledByPartner   Partner?       @relation("PatrolSchedulePartner", fields: [handledByPartnerId], references: [id])
  /// When partner-handled: true = the partner records in THEIR own app (we
  /// keep a stub, no /submit or ClientReport); false = the partner fills OUR
  /// form. Copied onto each materialised visit.
  partnerFillsOwnApp Boolean        @default(false)
  active            Boolean         @default(true)
  startsOn          DateTime?
  endsOn            DateTime?
  createdAt         DateTime        @default(now())

  visits            PatrolVisit[]

  @@index([siteId])
  @@index([assignedOfficerId])
  @@index([handledByPartnerId])
  @@index([kind])
}

model PatrolVisit {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId             String          @db.Uuid
  site               Site            @relation(fields: [siteId], references: [id])
  patrolScheduleId   String?         @db.Uuid
  patrolSchedule     PatrolSchedule? @relation(fields: [patrolScheduleId], references: [id])
  officerId          String?         @db.Uuid
  officer            User?           @relation(fields: [officerId], references: [id])
  /// Subcontracted visit: the partner who ran it (copied from the schedule).
  handledByPartnerId String?         @db.Uuid
  handledByPartner   Partner?        @relation("PatrolVisitPartner", fields: [handledByPartnerId], references: [id])
  /// Partner recorded it in their own app — no /submit, no ClientReport.
  reportedViaPartnerApp Boolean      @default(false)
  invoiceId          String?         @db.Uuid
  invoice            Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// Subcontracted patrol cost: what the partner charges us / pays their own
  /// officer for this visit. Snapshotted from PartnerRate; null for our own.
  partnerChargeToUsAmount Decimal?    @db.Decimal(10, 2)
  partnerOfficerPayAmount Decimal?    @db.Decimal(10, 2)
  scheduledAt        DateTime
  // UK calendar date (at UK midnight) of the night/day this visit is grouped
  // under. For overnight patrols the after-midnight visits carry the date of
  // the evening they started, so client reports group them under that night.
  scheduleDate       DateTime?
  // Cancellation audit (mirrors Job). statusBeforeCancel lets Restore return
  // the visit to where it was. cancelledByUserId is a plain audit stamp.
  cancelledAt        DateTime?
  cancelledByUserId  String?         @db.Uuid
  statusBeforeCancel VisitStatus?
  arrivedAt          DateTime?
  departedAt         DateTime?
  /// Officer location when the visit was submitted (optional).
  lat                Float?
  lng                Float?
  locatedAt          DateTime?
  status             VisitStatus     @default(PENDING)
  gpsLat             Float?
  gpsLng             Float?
  photoUrls          String[]        @default([])
  notes              String?
  billedAmount       Decimal?        @db.Decimal(10, 2)
  billedCurrency     String?
  billedAt           DateTime?
  payRateUnit        String?
  paidAmount         Decimal?        @db.Decimal(10, 2)
  paidCurrency       String?
  paidAt             DateTime?
  createdAt          DateTime        @default(now())

  job                Job?
  formSubmissions    FormSubmission[]

  @@index([siteId, scheduledAt])
  @@index([officerId, scheduledAt])
  @@index([handledByPartnerId])
  @@index([status])
}

model LockUnlockSchedule {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId            String      @db.Uuid
  site              Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  unlockTime        String?
  lockdownTime      String?
  days              DayOfWeek[] @default([])
  assignedOfficerId String?     @db.Uuid
  assignedOfficer   User?       @relation(fields: [assignedOfficerId], references: [id])
  active            Boolean     @default(true)

  @@index([siteId])
  @@index([assignedOfficerId])
}

model AlarmEvent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String         @db.Uuid
  site            Site           @relation(fields: [siteId], references: [id])
  source          AlarmSource
  receivedAt      DateTime       @default(now())
  rawSubject      String?
  rawBody         String?
  zone            String?
  priority        AlarmPriority  @default(MEDIUM)
  assignedToId    String?        @db.Uuid
  assignedTo      User?          @relation("AlarmAssignedTo", fields: [assignedToId], references: [id])
  outcome         AlarmOutcome?
  closedAt        DateTime?
  notes           String?
  createdAt       DateTime       @default(now())

  job             Job?

  @@index([siteId, receivedAt])
  @@index([assignedToId])
  @@index([priority])
}

model OnboardingPipeline {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId            String           @db.Uuid
  site              Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  program           CustomerProgram
  stage             OnboardingStage  @default(PROPOSED)
  targetGoLiveDate  DateTime?
  cancelReason      String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  jobs              Job[]

  @@index([siteId])
  @@index([stage])
}

model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id])
  entity      String
  entityId    String
  action      String
  diff        Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

model Partner {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String          @unique
  role        PartnerRole
  preferred   PartnerChannel  @default(EMAIL)
  emailIntake String?
  notes       String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  contacts        PartnerContact[]
  jobs            Job[]
  handledJobs     Job[]           @relation("JobHandlerPartner")
  handledShifts   Shift[]         @relation("ShiftHandlerPartner")
  handledPatrolSchedules PatrolSchedule[] @relation("PatrolSchedulePartner")
  handledPatrolVisits    PatrolVisit[]    @relation("PatrolVisitPartner")
  sites           Site[]          @relation("PartnerSites")
  formTemplates   FormTemplate[]
  /// Login seats — one per partner today (single shared login, Q1=a)
  /// but the relation is many-to-one so we can add more seats later
  /// without a schema change.
  users           User[]          @relation("PartnerUsers")
  /// Partner's private officer roster. Invisible to our /officers
  /// list; only readable from the partner portal scoped to this id.
  partnerOfficers PartnerOfficer[]
  /// Partner's rate card — what they charge us + pay their officer
  /// per service. Used to auto-fill activity-record forms.
  rates           PartnerRate[]

  @@index([role])
  @@index([active])
}

/// Officers belonging to a partner. Used for the partner's own
/// activity-record-keeping (Phase 1 read-only roster; Phase 2
/// assignable to partner-recorded jobs/shifts; Phase 3 can be linked
/// to a User row so they can sign in to /partner/m/* on their phone).
/// NOT in our staff /officers list — they never appear in any 1NW
/// dispatcher / admin picker.
model PartnerOfficer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId   String   @db.Uuid
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  siaNumber   String?
  notes       String?
  active      Boolean  @default(true)
  /// One-to-one link to a User with role=PARTNER_OFFICER. Optional
  /// — partners can add roster rows without giving each officer a
  /// login. SetNull on delete so deactivating the User row doesn't
  /// cascade and wipe the roster history.
  userId      String?  @unique @db.Uuid
  user        User?    @relation("PartnerOfficerLogin", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  handledJobs   Job[]
  handledShifts Shift[]

  @@index([partnerId, active])
}

/// Partner's rate card — one row per (partner, service). Auto-fills
/// the chargeToUs / payToOfficer fields when the partner records a
/// new activity; partner can still override per-activity.
model PartnerRate {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId    String      @db.Uuid
  partner      Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service      RateService
  chargeToUs   Decimal     @db.Decimal(10, 2)
  payToOfficer Decimal     @db.Decimal(10, 2)
  currency     String      @default("GBP")
  unit         RateUnit    @default(PER_VISIT)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([partnerId, service])
  @@index([partnerId])
}

model PartnerContact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId   String   @db.Uuid
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  role        String?
  notes       String?

  @@index([partnerId])
}

model Job {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                  JobType
  /// The specific sub-type label the operator picked (e.g. "Intruder alarm",
  /// "Camera activation") when the JobType code has several option aliases.
  /// Null = use the canonical label for `type`.
  typeLabel             String?
  source                JobSource
  status                JobStatus     @default(OPEN)
  priority              AlarmPriority @default(MEDIUM)

  siteId                String?       @db.Uuid
  site                  Site?         @relation(fields: [siteId], references: [id])

  customerId            String?       @db.Uuid
  customer              Customer?     @relation(fields: [customerId], references: [id])

  partnerId             String?       @db.Uuid
  partner               Partner?      @relation(fields: [partnerId], references: [id])

  onboardingPipelineId  String?       @db.Uuid
  onboardingPipeline    OnboardingPipeline? @relation(fields: [onboardingPipelineId], references: [id], onDelete: SetNull)

  responderType         ResponderType?
  assignedToUserId      String?       @db.Uuid
  assignedTo            User?         @relation("JobResponderUser", fields: [assignedToUserId], references: [id])
  externalResponder     String?

  // Partner-as-subcontractor: when we receive a job (e.g. Shurgard non-London
  // alarm) and hand it to Nexus / Keyholding Co. Their officer attends; we
  // keep this stub for the audit trail + the daily client email. Distinct
  // from `partnerId` above which mirrors Site.partnerId (partner-as-customer).
  handledByPartnerId    String?       @db.Uuid
  handledByPartner      Partner?      @relation("JobHandlerPartner", fields: [handledByPartnerId], references: [id])
  /// Set on partner-recorded jobs (Phase 2): which officer on their
  /// own roster actually attended. Invisible to our staff pages.
  handledByPartnerOfficerId  String?         @db.Uuid
  handledByPartnerOfficer    PartnerOfficer? @relation(fields: [handledByPartnerOfficerId], references: [id])
  /// Partner-side rate snapshot — what they're charging us for this
  /// activity (chargeToUs) and what they pay their officer
  /// (payToOfficer). Captured at create-time from PartnerRate; the
  /// partner can override on the form.
  partnerChargeToUsAmount    Decimal?        @db.Decimal(10, 2)
  partnerOfficerPayAmount    Decimal?        @db.Decimal(10, 2)
  /// True iff the job was created from /partner/activities/new — used
  /// to gate edit/cancel on the partner side and to distinguish from
  /// jobs our dispatch sent the partner.
  recordedByPartner          Boolean         @default(false)
  handedOffAt           DateTime?
  /// Last time dispatch was reminded to chase the partner for an update on
  /// this hand-off. Drives the 15-min chase cadence in the shift-checks cron;
  /// null until the first reminder. Chasing stops once the job is closed /
  /// cancelled / completed, or partnerReportRef is filled in.
  lastPartnerChaseAt    DateTime?

  alarmEventId          String?       @unique @db.Uuid
  alarmEvent            AlarmEvent?   @relation(fields: [alarmEventId], references: [id])
  patrolVisitId         String?       @unique @db.Uuid
  patrolVisit           PatrolVisit?  @relation(fields: [patrolVisitId], references: [id])
  shiftId               String?       @db.Uuid
  shift                 Shift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  scheduledFor          DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  /// Where the officer was when the activity was submitted / completed
  /// (web geolocation or a Telegram location share). Optional.
  lat                   Float?
  lng                   Float?
  locatedAt             DateTime?

  cancelledAt           DateTime?
  cancelledByUserId     String?       @db.Uuid
  cancelledBy           User?         @relation("JobCancelledBy", fields: [cancelledByUserId], references: [id])
  // Snapshot of Job.status the moment cancel was clicked, so Restore
  // puts the job back where it was rather than guessing OPEN/ASSIGNED.
  // Null on jobs that have never been cancelled.
  statusBeforeCancel    JobStatus?

  reportedViaPartnerApp Boolean       @default(false)
  partnerReportRef      String?

  invoiceId             String?       @db.Uuid
  invoice               Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  // Dispatcher-recorded callouts: bypass the /submit + review workflow.
  // recordedByUserId set means a dispatcher (or admin) typed this in
  // directly and the job lands at APPROVED. excludeFromClientReport
  // lets the dispatcher keep an entry internal (default: include).
  recordedByUserId      String?       @db.Uuid
  recordedBy            User?         @relation("JobRecordedBy", fields: [recordedByUserId], references: [id])
  excludeFromClientReport Boolean     @default(false)

  billedAmount          Decimal?      @db.Decimal(10, 2)
  billedCurrency        String?
  billedAt              DateTime?
  paidAmount            Decimal?      @db.Decimal(10, 2)
  paidCurrency          String?
  paidAt                DateTime?
  payRateUnit           String?

  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  formSubmissions       FormSubmission[]

  @@index([siteId, status])
  @@index([assignedToUserId, status])
  @@index([customerId])
  @@index([partnerId])
  @@index([handledByPartnerId])
  @@index([onboardingPipelineId])
  @@index([scheduledFor])
  @@index([status])
  @@index([shiftId])
}

model FormSubmission {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form                SubmissionForm
  formTemplateId      String?         @db.Uuid
  formTemplate        FormTemplate?   @relation(fields: [formTemplateId], references: [id], onDelete: SetNull)
  siteId              String?         @db.Uuid
  site                Site?           @relation(fields: [siteId], references: [id])
  jobId               String?         @db.Uuid
  job                 Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  patrolVisitId       String?         @db.Uuid
  patrolVisit         PatrolVisit?    @relation(fields: [patrolVisitId], references: [id], onDelete: SetNull)
  shiftId             String?         @db.Uuid
  shift               Shift?          @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  submittedByUserId   String?         @db.Uuid
  submittedBy         User?           @relation("SubmittedByUser", fields: [submittedByUserId], references: [id])
  officerNameRaw      String
  arrivedAt           DateTime?
  departedAt          DateTime?

  payload             Json            @default("{}")

  submittedAt         DateTime        @default(now())

  review              ReportReview?

  @@index([siteId, submittedAt])
  @@index([jobId])
  @@index([submittedByUserId])
  @@index([form])
  @@index([formTemplateId])
  @@index([patrolVisitId])
  @@index([shiftId])
}

model FormTemplate {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  jobType      SubmissionForm?
  scope        TemplateScope
  customerId   String?        @db.Uuid
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  partnerId    String?        @db.Uuid
  partner      Partner?       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  siteId       String?        @db.Uuid
  site         Site?          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fields       Json           @default("[]")
  active       Boolean        @default(true)
  blueprintId  String?        @db.Uuid
  blueprint    FormBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?        @db.Uuid
  createdBy    User?          @relation("FormTemplateAuthor", fields: [createdById], references: [id])

  submissions  FormSubmission[]

  @@index([scope, jobType, active])
  @@index([customerId])
  @@index([partnerId])
  @@index([siteId])
  @@index([blueprintId])
}

model FormBlueprint {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String          @unique
  name         String
  description  String?
  jobType      SubmissionForm?
  fields       Json            @default("[]")
  source       String?
  builtin      Boolean         @default(false)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdById  String?         @db.Uuid
  createdBy    User?           @relation("FormBlueprintAuthor", fields: [createdById], references: [id])

  templates    FormTemplate[]

  @@index([active])
  @@index([builtin])
}

model ReportReview {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId    String         @unique @db.Uuid
  submission      FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  status          ReviewStatus   @default(PENDING)
  reviewerId      String?        @db.Uuid
  reviewer        User?          @relation("ReportReviewer", fields: [reviewerId], references: [id])
  reviewedAt      DateTime?
  edits           Json?
  reviewerNotes   String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  clientReports   ClientReport[]

  @@index([status, createdAt])
}

model ClientReport {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId        String         @db.Uuid
  review          ReportReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  channel         ReportChannel  @default(EMAIL)
  toAddress       String
  subject         String?
  pdfUrl          String?
  status          ReportStatus   @default(PENDING)
  sentAt          DateTime?
  failureReason   String?

  createdAt       DateTime       @default(now())

  @@index([reviewId])
  @@index([status])
}

model Notification {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel         NotificationChannel @default(WHATSAPP)
  kind            NotificationKind
  recipientUserId String?             @db.Uuid
  recipientUser   User?               @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientNumber String?
  templateName    String
  templateParams  Json                @default("[]")
  bodyPreview     String?
  /// Plain-text body used by the SMS driver. WhatsApp rows render from
  /// templateName / templateParams instead; SMS rows render from bodyText.
  bodyText        String?
  status          NotificationStatus  @default(PENDING)
  attempts        Int                 @default(0)
  error           String?
  eventEntity     String?
  eventEntityId   String?
  sentAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([recipientUserId])
  @@index([eventEntity, eventEntityId])
  @@index([kind])
}

/// A parsed-but-unconfirmed callout from the Telegram bot. The dispatcher
/// messages the bot; we AI-parse + resolve it against the real roster and
/// stash the ready-to-create payload here, then show a Confirm/Cancel card.
/// Tapping Confirm creates the Job from `payload`; nothing is written to the
/// live board until then. Rows are short-lived (expire in minutes) and keyed
/// by an id that rides in the button callback_data.
model TelegramCalloutDraft {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId          String
  createdByUserId String   @db.Uuid
  createdBy       User     @relation("TelegramDraftCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  /// The resolved BotCalloutData (see src/lib/callouts.ts), ready to create.
  payload         Json
  /// Human-readable summary shown on the confirmation card.
  summary         String
  /// PENDING → CONFIRMED | CANCELLED. Terminal states are kept briefly for
  /// idempotency (a double-tap on Confirm/Cancel is a no-op).
  status          String   @default("PENDING")
  /// The confirmation message we sent, so we can edit it in place on action.
  messageId       Int?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([chatId, status])
  @@index([expiresAt])
}

/// Call events posted by the phone provider (bOnline) webhook. We always
/// store the raw payload so the parser can be tuned from real data, plus
/// best-effort normalised fields for the call log + missed-call alerts.
model CallEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @default("bonline")
  /// Provider's own call/event id when present — used to de-dupe repeated
  /// webhook deliveries for the same call.
  externalId  String?
  direction   String?   // INBOUND | OUTBOUND | UNKNOWN
  status      String?   // normalised: MISSED | ANSWERED | BUSY | ... | UNKNOWN
  rawStatus   String?   // the provider's own status string, for reference
  fromNumber  String?
  toNumber    String?
  durationSec Int?
  missed      Boolean   @default(false)
  /// True once a dispatch alert SMS has been queued for this missed call.
  alerted     Boolean   @default(false)
  occurredAt  DateTime? // event time from the payload when available
  payload     Json      @default("{}") // raw webhook body, always kept
  createdAt   DateTime  @default(now())

  @@index([occurredAt])
  @@index([missed])
  @@index([externalId])
  @@index([createdAt])
}

model Shift {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId             String       @db.Uuid
  site               Site         @relation(fields: [siteId], references: [id])
  officerId          String?      @db.Uuid
  officer            User?        @relation("ShiftOfficer", fields: [officerId], references: [id])
  /// Partner-recorded shifts (Phase 2): partner who handled the shift
  /// + their officer on their roster + partner rate snapshot.
  handledByPartnerId         String?         @db.Uuid
  handledByPartner           Partner?        @relation("ShiftHandlerPartner", fields: [handledByPartnerId], references: [id])
  handledByPartnerOfficerId  String?         @db.Uuid
  handledByPartnerOfficer    PartnerOfficer? @relation(fields: [handledByPartnerOfficerId], references: [id])
  partnerChargeToUsAmount    Decimal?        @db.Decimal(10, 2)
  partnerOfficerPayAmount    Decimal?        @db.Decimal(10, 2)
  recordedByPartner          Boolean         @default(false)
  type               ShiftType
  scheduledStartsAt  DateTime
  scheduledEndsAt    DateTime
  actualStartedAt    DateTime?
  actualEndedAt      DateTime?
  /// Officer location when the shift was submitted (optional).
  lat                Float?
  lng                Float?
  locatedAt          DateTime?
  status             ShiftStatus  @default(PENDING)
  checkIntervalMin   Int          @default(60)
  graceMinutes       Int          @default(15)
  notes              String?
  /// ── Officer link (token-gated public duty page at /duty/<token>) ──
  /// Unguessable secret. The officer opens ONLY this shift via the link;
  /// no login, no other access. Generated on create.
  publicToken        String?      @unique
  /// Name the officer typed on the duty page when the shift wasn't
  /// pre-assigned to a known officer / partner officer.
  officerNameRaw     String?
  /// Mobile we text the duty link to (E.164). For partner-handled shifts
  /// this is the partner officer's number; for own officers it can default
  /// to the User's phone.
  linkPhone          String?
  /// ── GPS capture + geofence result at start ──────────────────────────
  startLat           Float?
  startLng           Float?
  startGpsAccuracy   Float?
  /// Metres from the site at start (haversine). Null when site has no
  /// coordinates (geofence not enforced).
  startDistanceM     Float?
  startWithinGeofence Boolean?
  /// ── GPS capture + geofence result at end ────────────────────────────
  endLat             Float?
  endLng             Float?
  endGpsAccuracy     Float?
  endDistanceM       Float?
  endWithinGeofence  Boolean?
  /// Officer ended after the scheduled end → reason required + recorded.
  endedLate          Boolean      @default(false)
  lateReason         String?
  /// Actual worked minutes rounded UP to the next 30-min block — the basis
  /// for officer pay. Stored so the report shows the breakdown.
  payableMinutes     Int?
  /// Finance snapshots. Same shape as Job / PatrolVisit so /finance
  /// can aggregate shifts the same way. `billedAmount` = what we
  /// bill our customer (from SiteRate). `paidAmount` = what we pay
  /// our internal officer when officer-handled (from OfficerRate);
  /// stays null for partner-handled shifts — their cost is captured
  /// by `partnerChargeToUsAmount` above instead.
  billedAmount       Decimal?     @db.Decimal(10, 2)
  billedCurrency     String?
  billedAt           DateTime?
  paidAmount         Decimal?     @db.Decimal(10, 2)
  paidCurrency       String?
  paidAt             DateTime?
  payRateUnit        String?
  invoiceId          String?      @db.Uuid
  invoice            Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  formSubmissions    FormSubmission[]
  jobs               Job[]

  @@index([siteId, scheduledStartsAt])
  @@index([officerId, scheduledStartsAt])
  @@index([handledByPartnerId])
  @@index([status])
}

model OfficerRate {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officerId        String?     @db.Uuid
  officer          User?       @relation(fields: [officerId], references: [id], onDelete: Cascade)
  service          RateService
  amount           Decimal     @db.Decimal(10, 2)
  currency         String      @default("GBP")
  unit             RateUnit    @default(PER_VISIT)
  // Minutes covered by `amount`. Beyond this, excessRatePerMin applies.
  includedMinutes  Int?
  excessRatePerMin Decimal?    @db.Decimal(10, 4)
  validFrom        DateTime?
  validTo          DateTime?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([officerId, service])
  @@index([officerId])
  @@index([service])
}

/// Admin-managed labels + ordering for the JobType enum. The enum itself
/// is the DB-level storage primitive (Job.type still references it), but
/// the picker dropdowns and display surfaces read labels from here so
/// admins can rename, hide, reorder, and add alias labels for an existing
/// code without a code deploy. The first active option for a code is the
/// canonical display label.
model JobTypeOption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        JobType
  label       String
  description String?
  sortOrder   Int      @default(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([active, sortOrder])
}

/// Same pattern as JobTypeOption but for JobSource (Job.source).
model JobSourceOption {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        JobSource
  label       String
  description String?
  sortOrder   Int       @default(100)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
  @@index([active, sortOrder])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

/// A customer invoice for a billing period. Draft is generated from the
/// completed, billed, not-yet-invoiced activities for the customer in the
/// window; those activities are stamped with `invoiceId` so they can't be
/// double-invoiced. Voiding an invoice unlinks them again.
model Invoice {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          String        @unique
  customerId      String        @db.Uuid
  customer        Customer      @relation(fields: [customerId], references: [id])
  status          InvoiceStatus @default(DRAFT)
  periodFrom      DateTime
  periodTo        DateTime
  issuedAt        DateTime?
  emailedAt       DateTime?
  dueAt           DateTime?
  subtotal        Decimal       @db.Decimal(12, 2)
  /// Fractional rate, e.g. 0.2000 = 20% UK standard VAT.
  vatRate         Decimal       @db.Decimal(5, 4)
  vatAmount       Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  currency        String        @default("GBP")
  notes           String?
  /// Plain audit stamp — no relation, to keep the User model untouched.
  createdByUserId String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines           InvoiceLine[]
  jobs            Job[]
  visits          PatrolVisit[]
  shifts          Shift[]
  recurringRuns   RecurringChargeRun[]
  payments        InvoicePayment[]
  reminders       InvoiceReminder[]
  creditNotes     CreditNote[]

  @@index([customerId, status])
  @@index([status])
}

/// A reminder email sent to the customer about an overdue invoice. One row per
/// invoice + `stage` (unique), so each dunning stage fires at most once.
model InvoiceReminder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId String   @db.Uuid
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Which dunning stage this was, e.g. "overdue_7". See lib/reminders.ts.
  stage     String
  sentAt    DateTime @default(now())
  toEmail   String

  @@unique([invoiceId, stage])
  @@index([invoiceId])
}

enum CreditNoteStatus {
  ISSUED
  VOID
}

/// A credit note — reduces what a customer owes, for a correction, dispute,
/// goodwill or a service not delivered. Optionally linked to the invoice it
/// credits. A single net + VAT amount with a reason (not line-itemised).
/// Reduces the linked invoice's outstanding balance, and nets off output VAT
/// (Box 1) and sales (Box 6) on the VAT return by its issue date.
model CreditNote {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          String           @unique
  customerId      String           @db.Uuid
  customer        Customer         @relation(fields: [customerId], references: [id])
  invoiceId       String?          @db.Uuid
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status          CreditNoteStatus @default(ISSUED)
  issuedAt        DateTime         @default(now())
  reason          String
  subtotal        Decimal          @db.Decimal(12, 2)
  vatRate         Decimal          @db.Decimal(5, 4)
  vatAmount       Decimal          @db.Decimal(12, 2)
  total           Decimal          @db.Decimal(12, 2)
  currency        String           @default("GBP")
  notes           String?
  createdByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([customerId, status])
  @@index([invoiceId])
}

/// A payment received against an invoice — supports part payments. The
/// invoice flips to PAID once the payments cover its total.
model InvoicePayment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String   @db.Uuid
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(12, 2)
  paidOn          DateTime
  method          String?
  reference       String?
  notes           String?
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  @@index([invoiceId])
}

/// A manual pay line for an officer, dated into a payslip period — bonus,
/// expense, holiday pay, deduction, correction. `amount` is signed: positive
/// adds to pay, negative subtracts. Flows into the officer's payslip and the
/// payroll net total. `kind` is a free label (a small suggested set in the UI).
model PayAdjustment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officerId       String   @db.Uuid
  officer         User     @relation(fields: [officerId], references: [id], onDelete: Cascade)
  date            DateTime
  kind            String
  label           String
  amount          Decimal  @db.Decimal(12, 2)
  note            String?
  /// Plain audit stamp — no relation, to keep the User model untouched.
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  @@index([officerId, date])
}

/// A cost / supplier bill we've incurred — subcontractor invoices, fuel,
/// vehicles, uniforms, insurance, equipment, office. Carries input VAT so the
/// VAT return can reclaim it (Box 4) and P&L can reflect true net profit.
/// `date` is the bill (tax-point) date. `category` is a free label with a small
/// suggested set in the UI. `reclaimable` = whether the input VAT can be
/// reclaimed (a few categories, e.g. entertainment, can't).
model SupplierCost {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date            DateTime
  supplier        String
  category        String
  description     String?
  net             Decimal  @db.Decimal(12, 2)
  vatRate         Decimal  @db.Decimal(5, 4)
  vatAmount       Decimal  @db.Decimal(12, 2)
  gross           Decimal  @db.Decimal(12, 2)
  reference       String?
  reclaimable     Boolean  @default(true)
  /// When this bill is due to be paid (for the payables ageing + cash-flow
  /// forecast). Null = no due date recorded (treated as due on the bill date).
  dueOn           DateTime?
  /// When we actually paid it. Null = still outstanding (owed).
  paidOn          DateTime?
  notes           String?
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([paidOn])
}

model InvoiceLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String  @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  /// A secondary line under the description, e.g. the per-site breakdown
  /// "12 callouts · 24.5 hrs static/dog handling".
  detail      String?
  /// The RateService this line rolls up, for reference. Free-form.
  service     String?
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  @@index([invoiceId])
}

enum RecurringCadence {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_OFF
}

/// A standing charge billed to a customer on a cadence, independent of any
/// callout — keyholding retainers, monitoring subscriptions, annual contract
/// fees, one-off setup fees. Each period it's due materialises one
/// RecurringChargeRun (so it can't be billed twice) which is picked up by the
/// customer's next invoice.
model RecurringCharge {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String           @db.Uuid
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  description String
  /// Free-form RateService reference (e.g. ANNUAL_SUBSCRIPTION, KEYHOLDING).
  service     String?
  amount      Decimal          @db.Decimal(10, 2)
  currency    String           @default("GBP")
  cadence     RecurringCadence @default(MONTHLY)
  startDate   DateTime
  endDate     DateTime?
  active      Boolean          @default(true)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  runs        RecurringChargeRun[]

  @@index([customerId, active])
}

/// One occurrence of a RecurringCharge for a billing period. `periodKey` is
/// "YYYY-MM" (monthly), "YYYY-Qn" (quarterly), "YYYY" (annual) or "ONEOFF".
/// The unique constraint stops a period being billed twice; voiding an invoice
/// deletes its runs so the charge frees up again.
model RecurringChargeRun {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurringChargeId String          @db.Uuid
  recurringCharge   RecurringCharge @relation(fields: [recurringChargeId], references: [id], onDelete: Cascade)
  periodKey         String
  amount            Decimal         @db.Decimal(10, 2)
  invoiceId         String?         @db.Uuid
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@unique([recurringChargeId, periodKey])
  @@index([invoiceId])
}
